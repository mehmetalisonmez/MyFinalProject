{
  "TokenOptions": {
    "Audience": "engin@engin.com", //Bu alan çok önemli değil ama bir JWt ' de olması gerekir
    "Issuer": "engin@engin.com", //Bu alan çok önemli değil ama bir JWt ' de olması gerekir
    "AccessTokenExpiration": 10, //Dakika cinsinden bizim verdiğimiz token'ın geçerliliğini vertir önemli bir satırdır
    "SecurityKey": "your-long-security-key-of-at-least-64-characters-length-xxxxxxxxxxxxxx" //Bu yazdığımız hayatidir. Bu token'ı oluştururken asp.net ' in kullanacağıı anahtarın ismi olacak

  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
